{
  "name": "rollup-plugin-codefend",
  "version": "3.2.2",
  "description": "Rollup plugin for code obfuscation based on Codefend",
  "keywords": [
    "rollup",
    "rollup-plugin",
    "codefend",
    "obfuscate",
    "obfuscation",
    "obfuscator",
    "uglification",
    "uglify",
    "uglifier",
    "vue",
    "react",
    "angular",
    "svelte"
  ],
  "homepage": "https://github.com/Codefend/rollup-plugin-codefend.git",
  "bugs": {
    "url": "https://github.com/Codefend/rollup-plugin-codefend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codefend/rollup-plugin-codefend.git"
  },
  "author": "Mounzer Adas",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest",
    "test:run": "vitest --run",
    "build": "tsdown",
    "format": "prettier --write \"{src/**/*.ts,scripts/**/*.mjs,*.{ts,mts},*.js}\"",
    "format:check": "prettier --check \"{src/**/*.ts,scripts/**/*.mjs,*.{ts,mts},*.js}\"",
    "lint:check": "eslint src",
    "spell:check": "cspell \"{README.md,CHANGELOG.md,CODE_OF_CONDUCT.md,CONTRIBUTING.md,src/**/*.ts}\"",
    "type:check": "tsc --noEmit",
    "prepack": "npm run format:check && npm run lint:check && npm run spell:check && npm run type:check && npm run test:run && npm run build && npm run test:package",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitest/coverage-v8": "^5.1.2",
    "cspell": "^10.5.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "rollup": "^4.68.8",
    "rollup-3": "npm:rollup@^3.29.5"
  },
  "dependencies": {
    "codefend": "^3.2.1",
    "schema-utils": "^4.8.5"
  },
  "peerDependencies": {
    "rollup": ">=3.0.0 <5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
